{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "mcpServers": {
    "weather": {
      "type": "stdio",
      "command": "npx",
      "args": ["tsx", "mcp-servers/weather/src/index.ts"]
    },
    "images": {
      "type": "stdio",
      "command": "npx",
      "args": ["tsx", "mcp-servers/images/src/index.ts"]
    },
    "mssql": {
      "type": "stdio",
      "command": "npx",
      "args": ["tsx", "mcp-servers/mssql/src/index.ts"]
    }
  },
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Bash(mkdir:*)",
      "Bash(rm:*)",
      "Bash(ls:*)",
      "Bash(open:*)",
      "mcp__weather",
      "mcp__images",
      "mcp__mssql"
    ]
  }
}
