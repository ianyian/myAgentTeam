{
  "name": "petalpress",
  "version": "0.1.0",
  "private": true,
  "description": "PetalPress — a multi-agent team that builds a multilingual webpage with weather and country-flower content.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b",
    "build:mcp": "tsc -b mcp-servers/weather mcp-servers/images",
    "build:all": "npm run build && npm run build:mcp",
    "start": "tsx src/orchestrator.ts",
    "reset": "tsx scripts/reset.ts",
    "mcp:weather": "tsx mcp-servers/weather/src/index.ts",
    "mcp:images": "tsx mcp-servers/images/src/index.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.0",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "gray-matter": "^4.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "pptxgenjs": "^4.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
